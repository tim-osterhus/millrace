        "stage_result",
        "recon_packet"
      ]
    },
    {
      "terminal_state_id": "recon_blocked",
      "terminal_class": "blocked",
      "terminal_action_id": "recon_block_work_item",
      "writes_status": "RECON_BLOCKED",
