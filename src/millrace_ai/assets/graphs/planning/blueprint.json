        "stage_result",
        "blueprint_evaluation",
        "generated_task"
      ]
    },
    {
      "terminal_state_id": "arbiter_complete",
      "terminal_class": "success",
      "terminal_action_id": "complete_work_item",
      "writes_status": "ARBITER_COMPLETE",
      "emits_artifacts": [
        "stage_result",
        "verdict",
        "report"
      ]
    },
    {
      "terminal_state_id": "remediation_needed",
