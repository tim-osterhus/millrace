      "emits_artifacts": [
        "stage_result",
        "recon_packet",
        "generated_task"
      ]
    },
    {
      "terminal_state_id": "recon_to_planning",
      "terminal_class": "success",
      "terminal_action_id": "recon_enqueue_spec",
      "writes_status": "RECON_TO_PLANNING",
      "emits_artifacts": [
        "stage_result",
        "recon_packet",
        "generated_spec"
      ]
    },
    {
      "terminal_state_id": "recon_noop",
      "terminal_class": "no_op",
      "terminal_action_id": "recon_noop",
