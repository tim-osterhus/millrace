        "incident_report",
        "verdict",
        "report"
      ]
    },
    {
      "terminal_state_id": "blocked",
      "terminal_class": "blocked",
      "terminal_action_id": "block_work_item",
      "writes_status": "BLOCKED",
      "router_reason": "arbiter_blocked",
      "failure_class_template": "arbiter_blocked",
      "emits_artifacts": [
        "stage_result",
        "report"
      ]
    }
