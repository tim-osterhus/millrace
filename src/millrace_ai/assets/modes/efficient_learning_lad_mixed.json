{
  "schema_version": "1.0",
  "kind": "mode",
  "mode_id": "efficient_learning_lad_mixed",
  "loop_ids_by_plane": {
    "execution": "execution.lad",
    "planning": "planning.lad",
    "learning": "learning.standard"
  },
  "stage_entrypoint_overrides": {},
  "stage_skill_additions": {},
  "stage_model_bindings": {},
  "stage_runner_bindings": {
    "builder": "pi_rpc",
    "checker": "pi_rpc",
    "fixer": "pi_rpc",
    "doublechecker": "pi_rpc",
    "updater": "codex_cli",
    "troubleshooter": "codex_cli",
    "consultant": "codex_cli",
    "recon": "codex_cli",
    "planner": "codex_cli",
    "manager": "pi_rpc",
    "mechanic": "codex_cli",
    "auditor": "codex_cli",
    "arbiter": "codex_cli",
    "analyst": "pi_rpc",
    "professor": "codex_cli",
    "curator": "codex_cli",
    "librarian": "codex_cli"
  },
  "model_aliases": {
    "codex_max": {
      "model": "gpt-5.5",
      "thinking_level": "xhigh"
    },
    "codex_med": {
      "model": "gpt-5.5",
      "thinking_level": "medium"
    },
    "codex_fast": {
      "model": "gpt-5.4-mini",
      "thinking_level": "xhigh"
    },
    "deepseek_max": {
      "model": "deepseek-v4-pro",
      "thinking_level": "max"
    },
    "deepseek_med": {
      "model": "deepseek-v4-pro",
      "thinking_level": "high"
    },
    "deepseek_fast": {
      "model": "deepseek-v4-flash",
      "thinking_level": "max"
    }
  },
  "model_assignment": {
    "by_stage": {
      "arbiter": "codex_max",
      "troubleshooter": "codex_max",
      "mechanic": "codex_max",
      "planner": "codex_max",
      "recon": "codex_max",
      "consultant": "codex_max",
      "auditor": "codex_max",
      "librarian": "codex_med",
      "curator": "codex_med",
      "professor": "codex_med",
      "updater": "codex_fast",
      "manager": "deepseek_max",
      "checker": "deepseek_max",
      "doublechecker": "deepseek_max",
      "builder": "deepseek_med",
      "analyst": "deepseek_med",
      "fixer": "deepseek_fast"
    }
  },
  "concurrency_policy": {
    "mutually_exclusive_planes": [
      [
        "execution",
        "planning"
      ]
    ],
    "may_run_concurrently": [
      [
        "learning",
        "execution"
      ],
      [
        "learning",
        "planning"
      ]
    ]
  },
  "learning_trigger_rules": [
    {
      "rule_id": "execution.doublechecker.success-to-analyst",
      "source_plane": "execution",
      "source_stage": "doublechecker",
      "on_terminal_results": [
        "DOUBLECHECK_PASS"
      ],
      "target_stage": "analyst",
      "requested_action": "improve"
    },
    {
      "rule_id": "execution.troubleshooter.recovery-to-analyst",
      "source_plane": "execution",
      "source_stage": "troubleshooter",
      "on_terminal_results": [
        "TROUBLESHOOT_COMPLETE",
        "BLOCKED"
      ],
      "target_stage": "analyst",
      "requested_action": "improve"
    },
    {
      "rule_id": "execution.consultant.recovery-to-analyst",
      "source_plane": "execution",
      "source_stage": "consultant",
      "on_terminal_results": [
        "CONSULT_COMPLETE",
        "NEEDS_PLANNING",
        "BLOCKED"
      ],
      "target_stage": "analyst",
      "requested_action": "improve"
    },
    {
      "rule_id": "planning.planner.complete-to-librarian",
      "source_plane": "planning",
      "source_stage": "planner",
      "on_terminal_results": [
        "PLANNER_COMPLETE"
      ],
      "target_stage": "librarian",
      "requested_action": "install"
    }
  ],
  "required_extensions": [
    {
      "extension_package_id": "millrace.generic"
    },
    {
      "extension_package_id": "millrace.recon"
    },
    {
      "extension_package_id": "millrace.closure"
    },
    {
      "extension_package_id": "millrace.learning"
    }
  ]
}
