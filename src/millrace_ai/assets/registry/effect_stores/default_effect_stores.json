{
  "definitions": [
    {
      "schema_version": "1.0",
      "kind": "runtime_effect_store",
      "store_id": "run_artifacts",
      "store_type": "run_artifacts",
      "runtime_relative_root": "runs",
      "path_template": "runs/{run_id}",
      "owner": "stage",
      "write_policy": "read_only"
    },
    {
      "schema_version": "1.0",
      "kind": "runtime_effect_store",
      "store_id": "mutation_journal",
      "store_type": "mutation_journal",
      "runtime_relative_root": "state/runtime-effect-journal",
      "path_template": "state/runtime-effect-journal/{operation_id}.jsonl",
      "owner": "runtime",
      "write_policy": "append_only"
    },
    {
      "schema_version": "1.0",
      "kind": "runtime_effect_store",
      "store_id": "blueprint_manifests",
      "store_type": "blueprint_state",
      "runtime_relative_root": "blueprints/manifests",
      "path_template": "blueprints/manifests/{manifest_id}.json",
      "owner": "runtime",
      "write_policy": "idempotent_write"
    },
    {
      "schema_version": "1.0",
      "kind": "runtime_effect_store",
      "store_id": "blueprint_draft_queue",
      "store_type": "queue_family",
      "runtime_relative_root": "blueprints/drafts/queue",
      "path_template": "blueprints/drafts/queue/{draft_id}.json",
      "owner": "runtime",
      "write_policy": "idempotent_write"
    },
    {
      "schema_version": "1.0",
      "kind": "runtime_effect_store",
      "store_id": "blueprint_active_drafts",
      "store_type": "queue_family",
      "runtime_relative_root": "blueprints/drafts/active",
      "path_template": "blueprints/drafts/active/{draft_id}.json",
      "owner": "runtime",
      "write_policy": "idempotent_write"
    },
    {
      "schema_version": "1.0",
      "kind": "runtime_effect_store",
      "store_id": "blueprint_candidate_packets",
      "store_type": "blueprint_state",
      "runtime_relative_root": "blueprints/packets/candidates",
      "path_template": "blueprints/packets/candidates/{blueprint_id}.json",
      "owner": "runtime",
      "write_policy": "idempotent_write"
    },
    {
      "schema_version": "1.0",
      "kind": "runtime_effect_store",
      "store_id": "blueprint_candidate_markdown",
      "store_type": "blueprint_state",
      "runtime_relative_root": "blueprints/packets/candidates",
      "path_template": "blueprints/packets/candidates/{blueprint_id}.md",
      "owner": "runtime",
      "write_policy": "idempotent_write"
    },
    {
      "schema_version": "1.0",
      "kind": "runtime_effect_store",
      "store_id": "source_lifecycle",
      "store_type": "queue_family",
      "runtime_relative_root": "source-lifecycle",
      "path_template": "source-lifecycle/{family_id}/{state}/{work_item_id}",
      "owner": "runtime",
      "write_policy": "move"
    }
  ]
}
